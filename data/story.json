5.628789],["蘇澳",119.71113,25.602442],["金融中心",119.734277,25.59812],["北站",119.758182,25.604999],["第二大學",119.754518,25.585488],["中樓口",119.766896,25.564171],["中樓",119.773416,25.547822],["中央站",119.78226,25.531494]]},{"id":"L1","name":"L1 離島輕軌","sub":"本島—跨海—長嶼、東庠、草嶼・塘嶼、牛山","color":"#1fa3a3","type":"lrt","w":3,"y":2021,"branches":[[["中央站",119.7846,25.5325],["蘆洋",119.766,25.56],["蘇澳",119.7084,25.6169],["機場",119.714,25.662],["小練",119.658,25.664],["長嶼",119.643,25.677]],[["君山",119.833,25.572],["北港",119.8535,25.5917],["東庠",119.88,25.599]],[["金井",119.7436,25.4582],["南海",119.7273,25.4211],["草嶼",119.714,25.372],["塘嶼",119.693,25.33]],[["官姜",119.8073,25.5005],["澳前",119.845,25.472],["牛山島",119.937,25.435]]]}],"ROADS":[{"name":"長平高速（真實線位）","c":"expressway","y":2015,"path":[[119.6,25.705],[119.64,25.676],[119.68,25.648],[119.712,25.625],[119.722,25.598],[119.738,25.57],[119.745,25.54],[119.742,25.505],[119.735,25.49],[119.7,25.48],[119.64,25.465],[119.6,25.47],[119.56,25.49]]},{"name":"麗台跨海公路","c":"expressway","y":2024,"path":[[119.742,25.505],[119.768,25.5],[119.79,25.503],[119.812,25.499],[119.832,25.488],[119.85,25.472],[119.88,25.452],[119.93,25.432],[120.05,25.395]]},{"name":"北環大道","c":"arterial","y":2017,"path":[[119.712,25.6],[119.73,25.626],[119.76,25.642],[119.784,25.632],[119.79,25.605],[119.78,25.58]]},{"name":"世紀大道（中央軸）","c":"arterial","y":2016,"path":[[119.7575,25.6047],[119.766,25.58],[119.776,25.556],[119.785,25.535],[119.79,25.515],[119.799,25.495]]},{"name":"東岸大道","c":"arterial","y":2018,"path":[[119.806,25.513],[119.818,25.528],[119.83,25.545],[119.846,25.562],[119.836,25.58],[119.818,25.598],[119.8,25.618],[119.788,25.632]]},{"name":"南北縱貫路","c":"arterial","y":2017,"path":[[119.742,25.505],[119.74,25.48],[119.742,25.46],[119.75,25.438],[119.768,25.418]]},{"name":"環山南路","c":"major","y":2019,"path":[[119.799,25.493],[119.776,25.484],[119.762,25.465],[119.752,25.438]]}],"TOUR":[{"t":"序・白城","at":[119.77,25.54],"z":11.4,"p":55,"b":-15,"txt":"麗京特別市位於台灣海峽中央的海壇島，舊名平潭。2015 年劃為特別市後十年間快速開發，白色 CeraCore-9 外牆讓它有了「白城」之稱。"},{"t":"北端 CBD","id":"cecilia","z":15,"p":66,"b":35,"txt":"金融與企業總部的超高層群，沿著與真實幹道同向的棋盤街廓展開。480 m 的賽希莉亞塔是全市最高點，周圍是國際金融中心與交易所。"},{"t":"北站","id":"beizhan","z":16,"p":58,"b":-20,"txt":"高鐵與 M1、M2、M4、M6 四條捷運線的轉運站，三道波浪鋼構拱頂覆蓋月台，跨站大廳連接站前廣場與公車轉運區。"},{"t":"第二大學","id":"univ2","z":15.6,"p":58,"b":-40,"txt":"理工科為主的研究型大學，研究大樓以空橋相連，北側是實驗工廠與研究生宿舍。"},{"t":"中央站與政經區","id":"zhongyang","z":15.4,"p":60,"b":20,"txt":"舊平潭縣城（潭城）所在。中央站是五線轉乘的交通核心；周邊保留老街區紋理，外圍長出政經區的新街廓。"},{"t":"麗京市政府","id":"cityhall","z":16,"p":60,"b":160,"txt":"110 m 行政塔與左右翼樓，前方是列柱大廳與市民廣場，是城市的行政中樞。"},{"t":"議事堂","id":"yishitang","z":16.2,"p":62,"b":170,"txt":"將軍山北麓的半圓形議場，前有列柱門廊與前庭水池，鐘塔立於後方。不受白色外牆法規約束，保留石材原色。"},{"t":"南端文教區","id":"univ4","z":15.2,"p":58,"b":-20,"txt":"第四大學（藝術）與第五大學（海洋）所在，波浪屋頂的展演中心、湖畔工作室與戰前舊系館並存。"},{"t":"西岸住商混合區","id":"market","z":15.4,"p":58,"b":40,"txt":"中密度住宅與商店街，街廓中間留有巷道；傳統市場與娘宮舊港保留了戰前漁港的生活樣貌。"},{"t":"離島","id":"changyu","z":13.2,"p":55,"b":-60,"txt":"長嶼、東庠、塘嶼等離島以輕軌與本島相連，多數維持原居民的漁村聚落；對岸的高山鎮等地不屬特區，維持原本的發展步調。"}],"FACTS":{"name":"聯邦麗京特別市","en":"Lijing Special Municipality","brand":"Cecilia Rivendell","alias":"白城","old":"平潭（戰前平潭縣）","land":396,"sea":6064,"pop":2050000,"native":350000,"migrant":1700000,"peak":"君山 434.6 m","peak2":"將軍山系 約 350 m","wind":"冬季東北風（強）／夏季西南風（弱）","climate":"亞熱帶海洋性季風"}}